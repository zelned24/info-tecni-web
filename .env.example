# ==============================================================================
# VARIABLES DE ENTORNO (PLANTILLA DE CONFIGURACIÓN)
# Copia este archivo como .env.local y completa con los valores de tu proyecto Firebase
# ==============================================================================

# ─── 1. Firebase Client Configuration (Obligatorio) ───────────────────────────
# Obtenido desde: Firebase Console > Configuración del Proyecto > General > Tus apps > SDK Web
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy_tu_api_key_aqui
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=tu-proyecto-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=tu-proyecto.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# ─── 2. Clave Maestra de Seguridad (Supervisor / Eliminación de Informes) ────
# Hash SHA-256 de la contraseña requerida para confirmar eliminación de informes.
# Por defecto configurado con el hash de la clave de prueba: Admin2026.
# Para generar tu propio hash: node -e "console.log(require('crypto').createHash('sha256').update('TuClaveSegura').digest('hex'))"
NEXT_PUBLIC_PASS_ELIMINAR_HASH=5f374b2b3cc70bc1eded67a87b82cc5b78fa53c0b4b38c2a831ef60d834d3046

# ─── 3. Integración Opcional con Google Sheets (Catálogo de Sedes/Agencias) ──
# Si deseas sincronizar sedes desde una hoja pública de Google Sheets en tiempo real, coloca su ID aquí.
# Si lo dejas vacío, el sistema utilizará exclusivamente la colección 'agencias' de Firestore.
NEXT_PUBLIC_GOOGLE_SHEETS_ID=
